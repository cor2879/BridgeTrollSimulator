  m_Name: Intimidate
  m_EditorClassIdentifier: Assembly-CSharp::OldSchoolGames.BridgeTrollSimulator.Scripts.SocialDuel.Abilities.SocialAbility
  abilityName: Intimidate
  icon: {fileID: 0}
